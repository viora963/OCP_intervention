# Copier ce fichier en ".env" (déjà dans .gitignore) et renseigner les
# vraies valeurs. Ne JAMAIS committer le ".env" réel.

# False en production. True uniquement en développement local.
DEBUG=False

# Générer avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-key

# Domaines/IP autorisés à servir l'app, séparés par des virgules.
# Exemple : ALLOWED_HOSTS=intervention.ocpgroup.ma,10.20.30.40
ALLOWED_HOSTS=

# À terme, si migration vers PostgreSQL :
# DATABASE_URL=postgres://user:password@host:5432/ocp_intervention
