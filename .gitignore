# =========================================================
# INTERVIA - Django .gitignore
# =========================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# -------------------------
# Virtual environments
# -------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# -------------------------
# Django
# -------------------------
*.log
db.sqlite3
db.sqlite3-journal

# Collected static files
staticfiles/

# User-uploaded media
media/

# -------------------------
# Environment / secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Testing / Coverage
# -------------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/

# -------------------------
# Build / Packaging
# -------------------------
build/
dist/
*.egg-info/
.eggs/

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.bak

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Local development files
# -------------------------
*.sqlite3